<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- Label doit correspondre exactement au nom du fichier plist -->
    <key>Label</key>
    <string>com.msi.MSIMuteLEDAgent</string>

    <!-- Adapter selon l'emplacement réel du binaire compilé -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/MSIMuteLED/MSIMuteLEDAgent</string>
    </array>

    <!-- Démarre automatiquement au login utilisateur -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Relance uniquement si le processus crashe (code de sortie != 0).
         Ne relance PAS en cas d'arrêt propre via SIGTERM / launchctl stop.
         Évite les restart storms si le kext n'est pas encore chargé. -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Délai minimum entre deux redémarrages automatiques (secondes).
         Protège contre les boucles rapides si le service IOKit est absent. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Logs pour le debug — utile lors de la mise au point OpenCore -->
    <key>StandardOutPath</key>
    <string>/tmp/MSIMuteLEDAgent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/MSIMuteLEDAgent.err</string>

</dict>
</plist>
