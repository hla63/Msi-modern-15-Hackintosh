<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks Core Audio input devices without this:
         the default input device reads as unknown, so the mic mute key,
         its OSD and the mic LED sync stop working. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
